{
  "name": "health-ledger",
  "version": "2.8.0",
  "description": "A Firebase-backed vanilla JavaScript health tracker with daily logging, workout history, charts, cloud sync and an offline preview mode.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/health-ledger.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint . && node scripts/check-module-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.3",
    "globals": "^16.5.0",
    "prettier": "^3.8.1"
  }
}
