{
  "name": "health-ledger",
  "version": "2.9.3",
  "description": "A Firebase-backed vanilla JavaScript health tracker with daily logging, workout history, charts, cloud sync and an offline preview mode.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/health-ledger.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint . && node scripts/check-module-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
